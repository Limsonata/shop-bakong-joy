# Copy this file to .env.local and fill in the values, then restart `npm run dev`.
# .env.local is git-ignored — never commit real keys.
#
# IMPORTANT: this is a Vite / TanStack Start app (NOT Next.js).
#   - Client-side (browser) vars MUST be prefixed with VITE_ to be exposed.
#   - Server-only secrets have NO VITE_ prefix (never exposed to the browser).
#
# On Vercel, set the same variables under:
#   Settings → Environment Variables → Production (and Preview if you use it).
# After changing them, trigger a redeploy so the new build picks them up.

# ─────────────────────────────────────────────────────────────
# Supabase — REQUIRED
# Project Settings → API in the Supabase dashboard.
# ─────────────────────────────────────────────────────────────

# Public Supabase URL + publishable/anon key (safe to expose to the browser).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# ── Cloudinary media storage (optional, recommended) ──────────────────────
# When set, "Insert from device" in Admin → Content uploads images/videos to
# Cloudinary's CDN instead of the database/Supabase. Only URLs are stored.
# Create a free account, copy your Cloud Name, and create an UNSIGNED upload
# preset (Settings → Upload → Add upload preset → Signing mode: Unsigned).
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name

# Alternative name for the same public key (either one works):
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Used by the secure server functions in
# src/lib/api/ for admin writes and order creation. NEVER prefix with VITE_
# and NEVER expose to the browser. Without it, admin actions and order
# creation fail (e.g. "permission denied for table products").
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional server-side overrides (fall back to the VITE_ values above if unset):
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_ANON_KEY=your-anon-key

# ─────────────────────────────────────────────────────────────
# Telegram login & notifications — OPTIONAL (server-only secrets)
# ─────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# TELEGRAM_AUTH_SECRET=optional-separate-secret-for-login-hashing
# TELEGRAM_ADMIN_CHAT_ID=comma,separated,chat,ids

# Public Telegram bot name shown on the login widget (client):
# VITE_TELEGRAM_BOT_NAME=YourShopBot

# ─────────────────────────────────────────────────────────────
# Google Maps — OPTIONAL (client)
# Used by the checkout delivery-location picker.
# ─────────────────────────────────────────────────────────────
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─────────────────────────────────────────────────────────────
# Bakong / KHQR payment display — OPTIONAL (client)
# Sensible defaults exist in src/lib/bakong.ts; override as needed.
# ─────────────────────────────────────────────────────────────
# VITE_BAKONG_MERCHANT_NAME=BillieGrace Closet
# VITE_BAKONG_MERCHANT_ACCOUNT=your_account@bank
# VITE_BAKONG_MERCHANT_CITY=Phnom Penh
# VITE_BAKONG_QR_IMAGE_URL=
# VITE_BAKONG_CURRENCY=USD
# VITE_BAKONG_ACQUIRING_BANK=

# ─────────────────────────────────────────────────────────────
# App — OPTIONAL (client)
# Public base URL, used for building absolute links (e.g. auth redirects).
# ─────────────────────────────────────────────────────────────
# VITE_APP_URL=https://your-domain.com
